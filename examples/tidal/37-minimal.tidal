-- SuperDirtGUI from Tidal - 37: minimal
--
-- Nine parts meant to play at once, none of them loud: evaluate d1 to d9 in
-- order, then the variations. E, 126 bpm, in the manner of the Perlon and
-- Kompakt records. A tight 606 kick (sdgkick:2), plastic clicks for hats
-- (sdgplastic:3), a 909 rim on the off-beats and a tight clap on four
-- (sdgrim, sdgclap), a sub that only ever speaks for a sixteenth (sdgsub), a
-- single FM note (sdgfm) and pinged blips (sdgping) for the melody, a pad
-- that swells in once every four bars (sdgpad), the pedal hat (sdghat:1),
-- and two Dirt-Samples read through the crush and fold players (sdgcrush,
-- sdgfold) as micro-loops. sdgtime 0.357 is a dotted eighth at this tempo.
--
-- Minimal is the groove and nothing else: every sound is short, most of them
-- are quiet, and the changes are so slow you only notice them afterwards.

setcps (126/60/4)

let sdgdrive = pF "sdgdrive"
    sdgdecay = pF "sdgdecay"
    sdgpunch = pF "sdgpunch"
    sdgratio = pF "sdgratio"
    sdgindex = pF "sdgindex"
    sdgtone = pF "sdgtone"
    sdgcut = pF "sdgcut"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgcrush = pF "sdgcrush"
    sdgfold = pF "sdgfold"
    sdghold = pF "sdghold"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the kick: the 606 on every beat, a touch of drive
d1 $ s "sdgkick:2*4" # sdgdrive 0.2 # gain 0.95

-- d2, the hats: plastic clanks (:3) cut down to twelve milliseconds, on the
-- sixteenths, up a fifth every third bar, swaying left and right
d2 $ s "sdgplastic:3*16" # sdgdecay 0.012 # note "<0 0 7 0>" # gain "0.75 0.55 0.6 0.55" # pan (fast 4 $ range 0.3 0.7 sine)

-- d3, the 909 rim on the off-beat eighths, and the tight clap (:2) on four
d3 $ stack [
     s "[~ sdgrim:3]*4" # gain 0.8 # pan 0.6,
     s "~ ~ ~ sdgclap:2" # gain 0.75
   ]

-- d4, the bass: the sub on E for a sixteenth at a time, off the beat, a G on
-- the last step every other bar
d4 $ note "~ e2 ~ e2 ~ ~ e2 ~ ~ e2 ~ ~ ~ e2 ~ <~ g2>" # s "sdgsub" # legato 0.4 # sdgpunch 3 # gain 0.95

-- d5, the note: one FM note on the eleventh sixteenth, and every other bar
-- a second one on the last, short, echoed
d5 $ note "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ e7 ~ ~ ~ ~ <~ b6>" # s "sdgfm" # sdgratio 2 # sdgindex 0.5 # sdgdecay 0.1 # legato 1
   # gain 0.7 # sdgspace 0.4 # sdgtime 0.357

-- d6, blips: pings on the eighths, six in ten left out, their pitch wandering
-- over a fifth below and an octave above on slow noise, anywhere in the stereo
d6 $ degradeBy 0.6 $ s "sdgping:0*8" # note (segment 8 $ range (-7) 12 $ slow 5 perlin) # gain 0.7 # pan rand

-- d7, the pad: an E minor seventh swelling in on the fourth bar of every four
-- and gone again, the filter nearly shut
d7 $ every' 4 3 (const $ note "e4'min7" # s "sdgpad" # legato 1 # sdgcut 700 # sdgatk 1 # sdgrel 0.8 # gain 0.5) silence

-- d8, the pedal hat on the sixteenths, quieter than everything
d8 $ s "sdghat:1*16" # gain "0.6 0.5 0.55 0.5" # sdgtone 0.6 # pan 0.55

-- d9, micro-loops: a hat sample read through the crush player, its pointer
-- allowed on every fourth to 256th frame, a bar each; and a bass sample
-- folded back and forth inside a sliver of itself, a buzz, a quarter of a
-- cycle long
d9 $ stack [
     s "hh:3*4" # sdgcrush "<4 16 64 256>" # gain 0.7 # pan 0.3,
     s "~ ~ jvbass:2 ~" # sdgfold 0.03 # sdghold 0.25 # gain 0.6 # hpf 200
   ]

-- variations, over the top of all of it

-- the clicks in a three-step pattern over the sixteen, so the accent walks
-- round the bar, and the rim every third eighth
do
  d2 $ s "sdgplastic:3*16" # sdgdecay 0.012 # note "<0 0 7 0>" # gain "{0.75 0.55 0.6}%16" # pan (fast 4 $ range 0.3 0.7 sine)
  d3 $ stack [
       s "{~ ~ sdgrim:3}%8" # gain 0.8 # pan 0.6,
       s "~ ~ ~ sdgclap:2" # gain 0.75
     ]

-- the sub twice as long with more punch, and the note doubled a fifth down
do
  d4 $ note "~ e2 ~ e2 ~ ~ e2 ~ ~ e2 ~ ~ ~ e2 ~ <~ g2>" # s "sdgsub" # legato 0.9 # sdgpunch 8 # gain 0.95
  d5 $ superimpose (|- note 7) $ note "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ e7 ~ ~ ~ ~ <~ b6>" # s "sdgfm" # sdgratio 2 # sdgindex 0.5
     # sdgdecay 0.1 # legato 1 # gain 0.7 # sdgspace 0.4 # sdgtime 0.357

-- the pad on every bar, and the blips twice as often: the moment the track
-- opens, 32 bars in
do
  d7 $ note "<e4'min7 c4'maj7>" # s "sdgpad" # legato 1 # sdgcut 900 # sdgatk 1 # sdgrel 0.8 # gain 0.5
  d6 $ degradeBy 0.3 $ s "sdgping:0*16" # note (segment 16 $ range (-7) 12 $ slow 5 perlin) # gain 0.65 # pan rand

hush
