-- SuperDirtGUI from Tidal - 13: stuttery beats
--
-- A stutter is an event played again before it has finished. Tidal has many ways
-- to say so; each block below changes one thing about the same beat, so play them
-- in order and hear what each word does.

setcps (140/60/4)

let sdgcomb = pF "sdgcomb"
    sdgres = pF "sdgres"
    sdgwarp = pF "sdgwarp"
    sdgpitch = pF "sdgpitch"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"
    beat = s "[808bd:3 ~ [~ 808bd:3] ~ 808bd:3 [~ 808bd:3] ~ ~, ~ sn:3 ~ sn:3, 808hc*8]"

-- the beat, plain
d1 $ beat

-- ply: every event becomes n in its own space
d1 $ ply "<1 2 1 3>" $ beat

-- only the snare: fix changes what matches
d1 $ fix (ply "<2 4 8 [2 16]>") (s "sn") $ beat

-- only part of the bar: within works on a piece of the cycle
d1 $ within (0.75, 1) (ply 4) $ beat

-- a roll that fades: plyWith changes each repeat from the one before
d1 $ fix (plyWith 6 (|* gain 0.82)) (s "sn") $ beat

-- a roll that rises: each repeat a little faster in speed
d1 $ fix (plyWith 5 (|* speed 1.2)) (s "sn") $ beat

-- echoes that fall in the gaps: stut is copies, feedback and time apart
d1 $ fix (stut 4 0.6 (1/24)) (s "sn") $ beat

-- stutWith says what happens to each copy: higher, here
d1 $ fix (stutWith 4 (1/16) (|* speed 1.5)) (s "sn") $ beat

-- now and then, at random, for a fill nobody planned
d1 $ someCyclesBy 0.4 (within (0.5, 1) (ply "2 4 3 8")) $ beat

-- the last slice held: linger repeats the start of the bar for all of it
d1 $ every 4 (linger "<0.25 0.125>") $ beat

-- chew shrinks and speeds up the pieces it replays, so samples rise as they repeat
d1 $ chew 4 "0 1 [2 2] 3 [0 0 0] [1 1] 2*4 [3 3 3 3]" $ beat

-- a break, the classic way: chop cuts it, and bite plays the pieces in new orders
d1 $ bite 8 "0 1 [2 2] 3 4 [5 5 5] 6 [7*4]" $ loopAt 2 $ chop 32 $ s "breaks125" # gain 0.95

-- the same with the bites changing, and a very short one at the end of each fourth bar
d1 $ whenmod 4 3 (within (0.5, 1) (ply 8)) $ bite 8 "<[0 1 [2 2] 3 4 [5 5 5] 6 [7*4]] [0 [0 0] 2 [3 3] 4 4 [6*8] 7]>"
   $ loopAt 2 $ chop 32 $ s "breaks125" # gain 0.95

-- cut 1 stops each stutter at the next: tighter and more mechanical
d1 $ bite 8 "0 [1 1] [2 2 2] 3 4 [5*4] 6 [7*8]" $ loopAt 2 $ chop 32 $ s "breaks125" # gain 0.95 # cut 1

-- a stutter in the warp player keeps its pitch as it speeds up
d1 $ bite 8 "0 [1 1] [2 2 2] 3 4 [5*4] 6 [7*8]" $ loopAt 2 $ chop 32 $ s "breaks125" # sdgwarp 1
   # sdgpitch "<1 1 0.75 1.5>" # gain 0.95

-- a stutter through the comb, which turns a repeat into a note
d1 $ fix ((# sdgres 0.7) . (# sdgcomb "<0.2 0.3 0.45>") . ply 8) (s "sn") $ beat

-- and through the orbit's echo: note that every event has to carry it
d1 $ within (0.5, 1) (ply "4 2") $ beat # sdgspace 0.4 # sdgtime 0.32

-- a second orbit, so the stutter has something steady to fall against
d2 $ s "808bd:3*4" # shape 0.3 # gain 0.9

d3 $ degradeBy 0.3 $ s "glitch*16" # n (irand 8) # speed (choose [1, 1, 2, 0.5]) # pan rand # gain 0.7

hush
