-- SuperDirtGUI from Tidal - 31: dub techno
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. D minor, 120 bpm. A soft 808 kick, the 909 hat on the off-beat
-- only, a clap in a room (sdgkick, sdghat, sdgclap); the chord is a sync stab
-- (sdgsync) through its orbit's echo, which is the whole style: a chord that
-- is heard three or four times, dimmer each time. A sub holds the root
-- (sdgsub), a pad drifts under it (sdgpad), rim pings and an FM knock go into
-- echoes of their own (sdgrim, sdgfmdrum), and a Dirt-Samples juno chord is
-- read in slow grains (sdgcloud). sdgtime 0.375 is a dotted eighth here,
-- 0.75 a dotted quarter.
--
-- Dub techno is the echo: nearly every part has sdgspace on, and what you
-- hear is mostly repeats of what was played.

setcps (120/60/4)

let sdgdecay = pF "sdgdecay"
    sdgclick = pF "sdgclick"
    sdgtone = pF "sdgtone"
    sdgtail = pF "sdgtail"
    sdgsweep = pF "sdgsweep"
    sdgcut = pF "sdgcut"
    sdgq = pF "sdgq"
    sdgpunch = pF "sdgpunch"
    sdgmove = pF "sdgmove"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgcloud = pF "sdgcloud"
    sdggrain = pF "sdggrain"
    sdgscatter = pF "sdgscatter"
    sdgpitch = pF "sdgpitch"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the kick: the 808 kept short, no beater, dark
d1 $ s "sdgkick*4" # sdgdecay 0.4 # sdgclick 0 # sdgtone 0.15 # gain 0.95

-- d2, the hat: the 909 closed hat on the off-beat eighths only, and the last
-- of every fourth bar a little open
d2 $ s "[~ sdghat:3]*4" # sdgdecay "<0.09 0.09 0.09 [0.09 0.09 0.09 0.3]>" # gain 0.85

-- d3, the clap on two and four, quiet, in a room
d3 $ s "~ sdgclap ~ sdgclap" # sdgtail 0.3 # gain 0.75 # room 0.4 # size 0.8

-- d4, the chord: a minor ninth as a sync stab on the second, seventh and
-- eleventh sixteenths, the sweep nearly off, its filter breathing over
-- sixteen bars, and most of all the echo: dotted eighths, loud
d4 $ struct "~ t ~ ~ ~ ~ t ~ ~ ~ t ~ ~ ~ ~ ~" $ note "<d5'min9 d5'min9 d5'min9 a4'min9>" # s "sdgsync"
   # legato 1.5 # sdgsweep 0.5 # sdgdecay 0.3 # sdgcut (range 600 2500 $ slow 16 sine) # sdgq 0.3
   # sdgspace 0.6 # sdgtime 0.375 # gain 0.8

-- d5, the sub: the root on one, held a beat, and on the thirteenth and
-- fifteenth sixteenths a note that climbs to the third or the fifth
d5 $ note "d2 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ d2 ~ <f2 a2> ~" # s "sdgsub" # legato 4 # sdgpunch 2 # gain 0.95

-- d6, the pad: two chords, four bars each, the filter almost shut and
-- opening a little over 24 bars, three seconds in and out
d6 $ slow 4 $ note "<d4'min9 bf3'maj7>" # s "sdgpad" # legato 1 # sdgcut (range 250 1200 $ slow 24 sine)
   # sdgmove 0.6 # sdgatk 3 # sdgrel 3 # gain 0.65

-- d7, the rim: one ping on the eleventh sixteenth, into an echo that is
-- louder than the ping
d7 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ sdgrim ~ ~ ~ ~ ~" # sdgdecay 0.03 # sdgspace 0.55 # sdgtime 0.375 # gain 0.8

-- d8, the knock: the FM signpost (:5), three in eight, its offset changing
-- over four bars and its pitch with it, into a dotted-quarter echo
d8 $ euclidOff 3 8 "<0 0 3 5>" $ s "sdgfmdrum:5" # note "<0 7 -5 0>" # sdgdecay 0.1 # gain 0.75
   # pan (slow 9 sine) # sdgspace 0.3 # sdgtime 0.75

-- d9, the grains: a juno chord from Dirt-Samples, one event every four bars,
-- read at half speed in ten grains a second, an octave down every other time,
-- the lows and highs taken off
d9 $ slow 4 $ s "juno:2" # sdgcloud 10 # sdggrain 0.25 # sdgscatter 0.4 # speed 0.5 # sdgpitch "<1 0.5>"
   # gain 0.5 # hpf 400 # lpf 3000

-- variations, over the top of all of it

-- the chord's echo longer and the hat gone: the deep part
do
  d4 $ struct "~ t ~ ~ ~ ~ t ~ ~ ~ t ~ ~ ~ ~ ~" $ note "<d5'min9 d5'min9 d5'min9 a4'min9>" # s "sdgsync"
     # legato 1.5 # sdgsweep 0.5 # sdgdecay 0.3 # sdgcut 900 # sdgq 0.3 # sdgspace 0.8 # sdgtime 0.375 # gain 0.8
  d2 silence

-- the chord on another pattern every bar, and the pad brighter
do
  d4 $ struct "<[~ t ~ ~ ~ ~ t ~ ~ ~ t ~ ~ ~ ~ ~] [~ ~ ~ t ~ ~ ~ ~ ~ ~ t ~ ~ ~ ~ ~] [~ t ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~ ~ t ~]>"
     $ note "<d5'min9 d5'min9 d5'min9 a4'min9>" # s "sdgsync" # legato 1.5 # sdgsweep 0.5 # sdgdecay 0.3
     # sdgcut 1500 # sdgq 0.3 # sdgspace 0.6 # sdgtime 0.375 # gain 0.8
  d6 $ slow 4 $ note "<d4'min9 bf3'maj7>" # s "sdgpad" # legato 1 # sdgcut 2000 # sdgmove 1 # sdgatk 3 # sdgrel 3 # gain 0.65

-- the kick out for the last four bars of sixteen; the sub and the echoes
-- carry on
d1 $ whenmod 16 12 (const silence) $ s "sdgkick*4" # sdgdecay 0.4 # sdgclick 0 # sdgtone 0.15 # gain 0.95

hush
