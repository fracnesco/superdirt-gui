-- SuperDirtGUI from Tidal - 9: IDM, in the manner of Autechre
--
-- Not a copy of any track: the habits. A slower tempo, hard dry sounds, and
-- rhythm treated as a process: parts of different lengths that keep drifting
-- apart, so the bar is never quite where you left it. Let it run a few minutes.

setcps (92/60/4)

let sdgcomb = pF "sdgcomb"
    sdgres = pF "sdgres"
    sdgwarp = pF "sdgwarp"
    sdgpitch = pF "sdgpitch"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"
    sdgcut = pF "sdgcut"
    sdgq = pF "sdgq"
    sdgenv = pF "sdgenv"
    sdgdecay = pF "sdgdecay"
    sdgaccent = pF "sdgaccent"
    sdgwave = pF "sdgwave"

-- orbit 0: a kick in 16 steps, against a metal hit in 13 and a tick in 11.
-- {a b c}%16 plays one bar's worth of a longer list, so the three only line
-- up again every 2288 steps
d1 $ stack [
     s "{808bd:6 ~ ~ ~ ~ ~ 808bd:6 ~ ~ ~ 808bd:6 ~ ~ ~ ~ ~}%16" # shape 0.4 # lpf 900,
     s "{~ metal:2 ~ ~ tok ~ ~ ~ metal:5 ~ ~ tok:2 ~}%16" # hpf 800 # gain 0.8,
     s "{click ~ ~ click:2 ~ ~ click ~ click:3 ~ ~}%16" # pan (slow 5 sine) # gain 0.75
   ]

-- the same, with its time pushed about: perlin is slow noise, so the swing
-- wanders rather than jitters
d1 $ every "<5 7>" (iter 4) $ stack [
     s "{808bd:6 ~ ~ ~ ~ ~ 808bd:6 ~ ~ ~ 808bd:6 ~ ~ ~ ~ ~}%16" # shape 0.4 # lpf 900,
     s "{~ metal:2 ~ ~ tok ~ ~ ~ metal:5 ~ ~ tok:2 ~}%16" # hpf 800 # gain 0.8,
     s "{click ~ ~ click:2 ~ ~ click ~ click:3 ~ ~}%16" # pan (slow 5 sine) # gain 0.75
   ] # nudge (range 0 0.02 $ slow 3 perlin)

-- orbit 1: a percussion part that tunes itself: every hit goes through the comb
-- at another pitch, and euclid counts change every few bars
d2 $ euclidOff "<5 7 9 7>" 16 "<0 3 1>" $ s "perc" # n (irand 6)
   # sdgcomb (range 0.15 0.7 $ slow 7 sine) # sdgres (range 0.2 0.9 $ slow 11 perlin)
   # gain 0.85 # pan (slow 3 saw)

-- orbit 2: bass as punctuation: resonance high, the filter barely open, and
-- notes in a shape that shifts by one step at a time
d3 $ rot "<0 1 2 3 5>" $ note "{e3 ~ ~ f3 ~ e3 ~ ~ bf2 ~ ~ ~ e3}%16" # s "sdgacid" # sdgwave 1
   # legato 0.5 # sdgcut (range 80 400 $ slow 13 perlin) # sdgq 0.85 # sdgenv 0.35
   # sdgdecay 0.09 # sdgaccent "0 0 1 0 0 0.5" # gain 0.8

-- orbit 3: a chord that arrives late and in pieces
d4 $ slow 4 $ rolledBy "<0.1 -0.25 0.4>" $ note "<f'min11 df'maj9 bf'min9>" - 12
   # s "sdgacid" # legato 0.6 # sdgcut 500 # sdgq 0.4 # sdgenv 0.25 # sdgdecay 0.8
   # gain 0.7 # sdgspace 0.45 # sdgtime 0.49

-- orbit 4: the machine thinking: one slice of a break, re-read in grains at
-- pitches that do not belong to it
d5 $ degradeBy 0.5 $ slow 2 $ striate 12 $ s "breaks152" # sdgwarp 1 # speed 0.35
   # sdgpitch (segment 8 $ choose [0.5, 0.71, 1.06, 1.41, 2.12]) # hpf 300 # gain 0.7
   # pan rand # sdgspace 0.3 # sdgtime 0.16

-- strip it right back: only the process that drifts
mapM_ (\f -> f silence) [d3, d4, d5]

hush
