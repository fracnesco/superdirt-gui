-- SuperDirtGUI from Tidal - 36: downtempo
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. D minor, 86 bpm, in the manner of the Bristol records. A heavy
-- 808 kick and a fat snare a little behind the beat (sdgkick, sdgsnare with
-- nudge), swung 808 hats, a reese that holds (sdgreese), an electric piano
-- (sdgfm), scratches on spoken words (sdgscratch on numbers), a pad sample
-- washed out by the smear player (sdgsmear on pad), a pluck tune, and the
-- crackle of a record (sdgchaos:3) under all of it. sdgtime 0.523 is a dotted
-- eighth at this tempo.
--
-- Downtempo is a beat that drags: the snare late, the hats swung, the bass
-- holding, and dust on everything.

setcps (86/60/4)

let sdgdecay = pF "sdgdecay"
    sdgpunch = pF "sdgpunch"
    sdgnoise = pF "sdgnoise"
    sdgtone = pF "sdgtone"
    sdgdetune = pF "sdgdetune"
    sdgsub = pF "sdgsub"
    sdgcut = pF "sdgcut"
    sdgindex = pF "sdgindex"
    sdgscratch = pF "sdgscratch"
    sdgdepth = pF "sdgdepth"
    sdgsmear = pF "sdgsmear"
    sdghold = pF "sdghold"
    sdgpitch = pF "sdgpitch"
    sdgdamp = pF "sdgdamp"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the kick: the 808 on one and the "and" of three, every other bar one
-- more on the "and" of two
d1 $ s "sdgkick ~ ~ ~ ~ ~ ~ <~ sdgkick> ~ ~ sdgkick ~ ~ ~ ~ ~" # sdgdecay 0.6 # sdgpunch 10 # gain 0.95

-- d2, the snare: the fat one (:4) on two and four, 20 ms late (nudge), with
-- a short echo of its own
d2 $ s "~ sdgsnare:4 ~ sdgsnare:4" # sdgnoise 0.3 # nudge 0.02 # gain 0.9 # sdgspace 0.25 # sdgtime 0.523

-- d3, the hats: the 808 closed hat on the eighths, swung an eighth of a beat,
-- the open one on the fourth, the pedal on the last
d3 $ swingBy (1/8) 4 $ s "sdghat*8" # n "0 0 0 2 0 0 0 1" # cut 1 # gain "0.85 0.7" # sdgtone 0.5

-- d4, the bass: the reese holding a note for most of the bar, a dark filter,
-- the saws slow against each other; two notes near the end
d4 $ note "d2 ~ ~ ~ ~ ~ ~ ~ ~ ~ f2 ~ ~ ~ <a2 c3> ~" # s "sdgreese" # legato 6 # sdgcut 500 # sdgdetune 0.15
   # sdgsub 0.7 # gain 0.9

-- d5, the chords: the electric piano on one and the eleventh sixteenth, a
-- chord a bar, held ten sixteenths
d5 $ struct "t ~ ~ ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~ ~ ~" $ note "<d5'min9 bf4'maj9 g4'min9 a4'dom7>" # s "sdgfm"
   # sdgindex 1 # sdgdecay 0.8 # legato 10 # gain 0.75 # pan 0.4

-- d6, the scratches: three spoken numbers in the bar, half of them left out,
-- the read pointer wobbling three or seven times a second
d6 $ degradeBy 0.5 $ s "~ ~ ~ numbers:5 ~ ~ ~ ~ ~ numbers:1 ~ ~ ~ ~ numbers:8 ~" # sdgscratch "<3 7>"
   # sdgdepth "<0.02 0.06>" # gain 0.8 # pan 0.65 # hpf 300

-- d7, the wash: a Dirt-Samples pad read at half speed through the smear
-- player, each moment spread wide, held four bars (sdghold), an octave down
-- every other time
d7 $ slow 4 $ s "pad:2" # sdgsmear 0.7 # sdghold 4 # speed 0.5 # sdgpitch "<1 0.5>" # gain 0.5 # lpf 2500

-- d8, the tune: a pluck over two bars, few notes, each ringing three
-- sixteenths, echoed
d8 $ slow 2 $ note "~ a5 ~ f5 ~ ~ d5 ~ ~ ~ e5 ~ f5 ~ ~ ~ ~ ~ ~ ~ ~ ~ d6 ~ ~ c6 ~ a5 ~ ~ ~ ~" # s "sdgpluck"
   # legato 3 # sdgdamp 0.4 # gain 0.75 # sdgspace 0.35 # sdgtime 0.523 # pan 0.6

-- d9, the dust: the crackle preset of sdgchaos eight times a bar, quiet,
-- drifting across the stereo - a record's surface
d9 $ s "sdgchaos:3*8" # gain 0.55 # sdgtone 0.3 # pan (slow 11 sine)

-- variations, over the top of all of it

-- the beat halved: the snare on three only, the kick on one, for a verse
do
  d1 $ s "sdgkick ~ ~ ~ ~ ~ ~ ~ ~ ~ <sdgkick ~> ~ ~ ~ ~ ~" # sdgdecay 0.8 # sdgpunch 10 # gain 0.95
  d2 $ s "~ ~ sdgsnare:4 ~" # sdgnoise 0.3 # nudge 0.02 # gain 0.9 # sdgspace 0.25 # sdgtime 0.523

-- the piano on every chord tone in turn, an arpeggio, the bass up an octave
-- with a brighter filter
do
  d5 $ note (arp "<up down>" "<d5'min9'8 bf4'maj9'8 g4'min9'8 a4'dom7'8>") # s "sdgfm" # sdgindex 1
     # sdgdecay 0.8 # legato 2 # gain 0.7 # pan 0.4
  d4 $ note "d3 ~ ~ ~ ~ ~ ~ ~ ~ ~ f3 ~ ~ ~ <a3 c4> ~" # s "sdgreese" # legato 6 # sdgcut 1200 # sdgdetune 0.15
     # sdgsub 0.5 # gain 0.85

-- the scratches all in and faster, and the wash brighter: the end section
do
  d6 $ s "~ ~ ~ numbers:5 ~ ~ ~ ~ ~ numbers:1 ~ ~ ~ ~ numbers:8 ~" # sdgscratch "<9 14>"
     # sdgdepth "<0.04 0.08>" # gain 0.8 # pan 0.65 # hpf 300
  d7 $ slow 4 $ s "pad:2" # sdgsmear 0.5 # sdghold 4 # speed 0.5 # sdgpitch "<1 2>" # gain 0.5 # lpf 6000

hush
