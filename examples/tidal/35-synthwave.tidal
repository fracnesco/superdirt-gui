-- SuperDirtGUI from Tidal - 35: synthwave
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. A minor, 105 bpm, the four chords every one of these records
-- has - Am, F, C, G - a bar each. The 909 kick with a gated snare (sdgkick,
-- sdgsnare and SuperDirt's room), 909 hats, a bass in octave sixteenths
-- (sdgreese with a short envelope), the supersaw on the chords, a lead with
-- late vibrato (sdglead), a pluck arpeggio, strings an octave up, tom fills
-- (sdgtom) and a crash with FM bells (sdgcymbal, sdgfm). sdgtime 0.429 is a
-- dotted eighth at this tempo.
--
-- The habit to copy is the bass: one note, two octaves, sixteen times a bar,
-- under chords that never stop. Everything else is decoration.

setcps (105/60/4)

let sdgdecay = pF "sdgdecay"
    sdgnoise = pF "sdgnoise"
    sdgtone = pF "sdgtone"
    sdgcolor = pF "sdgcolor"
    sdgdetune = pF "sdgdetune"
    sdgsub = pF "sdgsub"
    sdgcut = pF "sdgcut"
    sdgenv = pF "sdgenv"
    sdgwidth = pF "sdgwidth"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgvib = pF "sdgvib"
    sdgvibdelay = pF "sdgvibdelay"
    sdgdamp = pF "sdgdamp"
    sdgchorus = pF "sdgchorus"
    sdgratio = pF "sdgratio"
    sdgindex = pF "sdgindex"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, kick and snare: the 909 kick on every beat, and the 909 snare on two
-- and four with a long noise and SuperDirt's room: the gated snare of the
-- eighties, more or less
d1 $ stack [
     s "sdgkick:1*4" # sdgdecay 0.5 # gain 0.9,
     s "~ sdgsnare:1 ~ sdgsnare:1" # sdgnoise 0.5 # sdgtone 0.6 # gain 0.9 # room 0.5 # size 0.6
   ]

-- d2, the hats: the 909 closed hat on the eighths, off-beats quieter, and
-- every other bar the open hat on the last one
d2 $ s "sdghat:3*8" # gain "0.85 0.7" # sdgdecay "<0.08 [0.08 0.08 0.08 0.08 0.08 0.08 0.08 0.3]>"

-- d3, the bass: the root of each chord alternating with its octave, sixteen
-- notes a bar, the reese with its saws nearly together and a short filter
-- envelope so each note plucks
d3 $ note "<[a2 a3]*8 [f2 f3]*8 [c3 c4]*8 [g2 g3]*8>" # s "sdgreese" # legato 0.5 # sdgdetune 0.05 # sdgsub 0.5
   # sdgcut 900 # sdgenv 0.35 # sdgdecay 0.08 # gain 0.85

-- d4, the chords: the supersaw holding each one for the bar, a slow attack
-- and release, the filter half open
d4 $ note "<a4'min f4'maj c5'maj g4'maj>" # s "sdgsupersaw" # legato 1 # sdgdetune 0.35 # sdgwidth 0.9
   # sdgcut 2500 # sdgatk 0.3 # sdgrel 0.5 # gain 0.65

-- d5, the lead: a tune over two bars, two detuned saws, the vibrato
-- arriving a third of a second into each note, echoed
d5 $ slow 2 $ note "e6 ~ ~ c6 ~ d6 ~ ~ e6 ~ g6 ~ ~ a6 ~ ~ g6 ~ ~ e6 ~ ~ ~ ~ d6 ~ c6 ~ ~ ~ ~ ~" # s "sdglead"
   # sdgvib 0.25 # sdgvibdelay 0.3 # sdgcut 1800 # sdgenv 0.3 # sdgdetune 0.25 # legato 1.2 # gain 0.85
   # sdgspace 0.35 # sdgtime 0.429

-- d6, the arpeggio: the chord as a pluck in eighths, up one bar and down the
-- next, dull strings, wandering across the stereo
d6 $ note (arp "<up down>" "<a4'min'8 f4'maj'8 c5'maj'8 g4'maj'8>") # s "sdgpluck" # legato 1 # sdgdamp 0.6
   # sdgdecay 0.6 # gain 0.75 # pan (slow 5 sine)

-- d7, the strings: the chords an octave above the supersaw, a one-second
-- swell, deep chorus, quiet
d7 $ note "<a5'min f5'maj c6'maj g5'maj>" # s "sdgstrings" # legato 1 # sdgatk 1 # sdgchorus 0.8 # gain 0.5

-- d8, the toms: a fill on the last bar of eight, the 909-coloured tom
-- (sdgcolor 1) running down, in the room
d8 $ whenmod 8 7 (const $ note "[~ 7] [5 5] [2 2] [0 -5]" # s "sdgtom" # sdgcolor 1 # sdgdecay 0.5 # gain 0.9 # room 0.3) silence

-- d9, a crash on the first beat of every eighth bar, and FM bells on four
-- notes of A minor, high, half of them left out
d9 $ stack [
     every' 8 0 (const $ s "sdgcymbal:1 ~ ~ ~" # sdgdecay 3 # gain 0.6) silence,
     degradeBy 0.5 $ note (arp "up" "a6'min'4") # s "sdgfm" # sdgratio 3.5 # sdgindex 1.5 # sdgdecay 1
       # legato 2 # gain 0.6 # pan rand
   ]

-- variations, over the top of all of it

-- the chords through a filter that opens over sixteen bars, and the bass
-- opening with them
do
  d4 $ note "<a4'min f4'maj c5'maj g4'maj>" # s "sdgsupersaw" # legato 1 # sdgdetune 0.35 # sdgwidth 0.9
     # sdgcut (range 500 8000 $ slow 16 sine) # sdgatk 0.3 # sdgrel 0.5 # gain 0.65
  d3 $ note "<[a2 a3]*8 [f2 f3]*8 [c3 c4]*8 [g2 g3]*8>" # s "sdgreese" # legato 0.5 # sdgdetune 0.05 # sdgsub 0.5
     # sdgcut (range 500 2500 $ slow 16 sine) # sdgenv 0.35 # sdgdecay 0.08 # gain 0.85

-- the gated snare bigger, and the kick twice on the last beat every other bar
d1 $ stack [
     s "sdgkick:1*4" # sdgdecay 0.5 # gain 0.9,
     s "<~ [~ ~ ~ sdgkick:1]>" # sdgdecay 0.3 # gain 0.9,
     s "~ sdgsnare:1 ~ sdgsnare:1" # sdgnoise 0.7 # sdgtone 0.6 # gain 0.9 # room 0.8 # size 0.7
   ]

-- the lead an octave down and doubled a fifth up, quieter, for the chorus
d5 $ superimpose ((|+ note 7) . (|* gain 0.75)) $ slow 2
   $ note "e5 ~ ~ c5 ~ d5 ~ ~ e5 ~ g5 ~ ~ a5 ~ ~ g5 ~ ~ e5 ~ ~ ~ ~ d5 ~ c5 ~ ~ ~ ~ ~" # s "sdglead"
   # sdgvib 0.25 # sdgvibdelay 0.3 # sdgcut 1800 # sdgenv 0.3 # sdgdetune 0.25 # legato 1.2 # gain 0.85
   # sdgspace 0.35 # sdgtime 0.429

-- the arpeggio in sixteenths (every note twice) and the strings gone
do
  d6 $ ply 2 $ note (arp "<up down>" "<a4'min'8 f4'maj'8 c5'maj'8 g4'maj'8>") # s "sdgpluck" # legato 1
     # sdgdamp 0.6 # sdgdecay 0.4 # gain 0.75 # pan (slow 5 sine)
  d7 silence

hush
