-- SuperDirtGUI from Tidal - 28: trap
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. F minor, 140 bpm in half time, so the snare falls on three. The
-- 808 is the bass: the deep sub kick (sdgkick:4) tuned to F plays the line,
-- with cut 1 so each note stops the last. The 606 hat rolls (sdghat, ply), the
-- snare and the clap land together, an FM bell carries the tune, a choir holds
-- the chord with its mouth shut, a pluck answers, latex snaps and a stick
-- (sdgplastic, sdgrim) fill in, and the crushed ratchet (sdgratchet) rolls into
-- every fourth bar. sdgtime 0.321 is a dotted eighth at this tempo.
--
-- Trap is space: a few sounds, far apart, each one big. Nothing here plays on
-- every step except the hats, and they are the quietest thing in it.

setcps (140/60/4)

let sdgfreq = pF "sdgfreq"
    sdgdecay = pF "sdgdecay"
    sdgdrive = pF "sdgdrive"
    sdgnoise = pF "sdgnoise"
    sdgtone = pF "sdgtone"
    sdgtail = pF "sdgtail"
    sdgratio = pF "sdgratio"
    sdgindex = pF "sdgindex"
    sdgvowel = pF "sdgvowel"
    sdgbreath = pF "sdgbreath"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgdamp = pF "sdgdamp"
    sdgcount = pF "sdgcount"
    sdglen = pF "sdglen"
    sdgcurve = pF "sdgcurve"
    sdgwalk = pF "sdgwalk"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the 808: the deep sub kick tuned to F (43.65 Hz at note 0), a line in
-- semitones - F, then Ab, Eb, Bb or Db at the end of the bar - each note long
-- and stopping the one before (cut 1)
d1 $ note "0 ~ ~ ~ 0 ~ 0 ~ ~ ~ ~ 0 ~ ~ <3 -2 5 -4> ~" # s "sdgkick:4" # sdgfreq 43.65 # sdgdecay 1.8
   # sdgdrive 0.2 # cut 1

-- d2, the hats: the 606 hat (:5) on the eighths, some of them rolled into two,
-- three or four (ply), swaying left and right; an open hat on the last eighth
d2 $ stack [
     ply "1 <1 2> 1 <2 4> 1 1 <3 1> 2" $ s "sdghat:5*8" # gain "0.9 0.8" # pan (range 0.3 0.7 $ fast 2 sine),
     s "~ ~ ~ ~ ~ ~ ~ sdghat:2" # sdgdecay 0.3 # gain 0.8
   ]

-- d3, the snare and the clap together on three, the tight snare with a
-- little more noise, the 909 clap with a room
d3 $ stack [
     s "~ ~ sdgsnare:2 ~" # sdgnoise 0.35 # sdgtone 0.5 # gain 0.95,
     s "~ ~ sdgclap:1 ~" # sdgtail 0.4 # gain 0.85
   ]

-- d4, the tune: an FM bell, a phrase one bar and nearly nothing the next,
-- every note held four sixteenths and echoed in dotted eighths
d4 $ note "<[f6 ~ af6 ~ c7 ~ ~ ef7 ~ c7 ~ af6 ~ ~ g6 ~] [f6 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]>" # s "sdgfm"
   # sdgratio 3.5 # sdgindex 1.5 # sdgdecay 1.2 # legato 4 # gain 0.75 # sdgspace 0.3 # sdgtime 0.321

-- d5, the choir: two chords, two bars each, on the vowel u (sdgvowel 4): a
-- hum behind everything
d5 $ slow 2 $ note "<f4'min9 df4'maj7>" # s "sdgchoir" # legato 1 # sdgvowel 4 # sdgbreath 0.2
   # sdgatk 1.5 # sdgrel 1.5 # gain 0.6

-- d6, the pluck: three notes at the end of the bar, a quarter earlier every
-- other bar, answering the bell
d6 $ every 2 (0.25 <~) $ note "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [c6 af5] ~ f5 ~" # s "sdgpluck" # legato 2
   # sdgdamp 0.5 # gain 0.75 # pan 0.3

-- d7, small percussion: latex snaps (sdgplastic:1) on the "and" of two and
-- four, down a fourth every third bar, and a stick (sdgrim:4) on the fourth
-- and twelfth sixteenths
d7 $ stack [
     s "~ ~ ~ ~ ~ ~ sdgplastic:1 ~ ~ ~ ~ ~ ~ ~ sdgplastic:1 ~" # note "<0 0 -5>" # gain 0.85 # pan 0.65,
     s "~ ~ ~ sdgrim:4 ~ ~ ~ ~ ~ ~ ~ sdgrim:4 ~ ~ ~ ~" # gain 0.8 # pan 0.35
   ]

-- d8, the roll: on the last beat of every fourth bar, 32 even clicks of the
-- crushed ratchet (:4), noisy, staying on one pitch - a hat roll in one event
d8 $ whenmod 4 3 (const $ s "~ ~ ~ sdgratchet:4" # sdgcount 32 # sdglen 0.42 # sdgcurve 0 # sdgtone 1 # sdgwalk 0 # gain 0.85) $ silence

-- d9, a zap (sdgping:4) on the last quarter of every fourth bar, echoed, up a
-- fifth every other time
d9 $ s "<~ ~ ~ [~ ~ ~ sdgping:4]>" # note "<0 7>" # gain 0.8 # sdgspace 0.5 # sdgtime 0.321

-- variations, over the top of all of it

-- the 808 line busier and shorter, two notes at the end of the bar
d1 $ note "0 ~ ~ 0 ~ ~ 0 ~ ~ ~ 0 ~ ~ <3 -2> <5 -4> ~" # s "sdgkick:4" # sdgfreq 43.65 # sdgdecay 1.2
   # sdgdrive 0.3 # cut 1

-- the hats in triplets every fourth bar, and the snare with a longer tail
do
  d2 $ whenmod 4 3 (const $ s "sdghat:5*12" # gain "0.9 0.75 0.8") $ stack [
       ply "1 <1 2> 1 <2 4> 1 1 <3 1> 2" $ s "sdghat:5*8" # gain "0.9 0.8" # pan (range 0.3 0.7 $ fast 2 sine),
       s "~ ~ ~ ~ ~ ~ ~ sdghat:2" # sdgdecay 0.3 # gain 0.8
     ]
  d3 $ stack [
       s "~ ~ sdgsnare:2 ~" # sdgnoise 0.6 # sdgtone 0.5 # gain 0.95,
       s "~ ~ sdgclap:1 ~" # sdgtail 0.8 # gain 0.85
     ]

-- the tune an octave down and slower, half the notes gone: the second half
-- of the track
d4 $ slow 2 $ degradeBy 0.3 $ note "<[f5 ~ af5 ~ c6 ~ ~ ef6 ~ c6 ~ af5 ~ ~ g5 ~] [f5 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]>"
   # s "sdgfm" # sdgratio 3.5 # sdgindex 2 # sdgdecay 1.5 # legato 4 # gain 0.75 # sdgspace 0.4 # sdgtime 0.321

-- the choir opening its mouth over sixteen bars, a to u and back
d5 $ slow 2 $ note "<f4'min9 df4'maj7>" # s "sdgchoir" # legato 1 # sdgvowel (segment 8 $ slow 16 $ range 0 4 sine)
   # sdgbreath 0.2 # sdgatk 1.5 # sdgrel 1.5 # gain 0.6

hush
