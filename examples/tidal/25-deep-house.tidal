-- SuperDirtGUI from Tidal - 25: deep house
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. D minor, 122 bpm, a four-chord turnaround - Dm9, G9, Dm9, Bbmaj9
-- - that every melodic part follows. The drums are the 808 (sdgkick, sdghat,
-- sdgclap, sdgsnare, sdgrim, sdgcowbell) and a ride (sdgcymbal); the chords an
-- electric piano (sdgfm), the bass a sub (sdgsub), a pluck arpeggio and a
-- string machine on top. Swing is swingBy (1/12) 4: the second half of every
-- beat a twelfth late.
--
-- Deep house is a matter of what is left out: the kick is a thump, not a
-- punch, the hats sit back, nothing is bright, and the chords are off the beat.

setcps (122/60/4)

let sdgdecay = pF "sdgdecay"
    sdgclick = pF "sdgclick"
    sdgtone = pF "sdgtone"
    sdgtail = pF "sdgtail"
    sdgsnap = pF "sdgsnap"
    sdgpunch = pF "sdgpunch"
    sdgratio = pF "sdgratio"
    sdgindex = pF "sdgindex"
    sdgdamp = pF "sdgdamp"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgcut = pF "sdgcut"
    sdgchorus = pF "sdgchorus"
    sdgcolor = pF "sdgcolor"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the kick: the 808 shortened to a thump, the beater soft and dark
d1 $ s "sdgkick*4" # sdgdecay 0.45 # sdgclick 0.1 # sdgtone 0.2

-- d2, the hats: the 808 closed hat on the eighths with the pedal (:1) on the
-- last one, an open hat (:2) now and then, swung; cut 1 chokes the open ones
d2 $ swingBy (1/12) 4 $ s "sdghat*8" # n "0 <0 2> 0 0 0 <2 0> 0 1" # cut 1 # gain "0.85 0.95"

-- d3, clap and snare together on two and four, the 808 pair; the clap has a
-- deep room, the snare mostly snares
d3 $ stack [
     s "~ sdgclap ~ sdgclap" # sdgtail 0.6 # gain 0.9,
     s "~ sdgsnare ~ sdgsnare" # sdgsnap 0.7 # sdgtone 0.3 # gain 0.75
   ]

-- d4, the chords: the electric piano off the beat, a chord a bar; legato 6
-- holds each stab six sixteenths, into the next
d4 $ struct "~ t ~ ~ t ~ ~ ~ ~ t ~ ~ ~ ~ t ~" $ note "<d5'min9 g5'dom9 d5'min9 bf4'maj9>" # s "sdgfm"
   # sdgratio 1 # sdgindex 1.2 # sdgdecay 0.6 # legato 6 # gain 0.8 # pan 0.45

-- d5, the bass: the sub on the roots, every third eighth and a half, the way
-- a house bass walks against the kick; up the octave at the end of a bar
d5 $ note "<[d2 ~ ~ d2 ~ ~ d2 ~] [g2 ~ ~ g2 ~ ~ g2 g3] [d2 ~ ~ d2 ~ ~ d2 ~] [bf2 ~ ~ bf2 ~ ~ f2 ~]>"
   # s "sdgsub" # legato 0.7 # sdgpunch 5 # gain 0.95

-- d6, the pluck: the chord as an arpeggio in eighths, up one bar and up and
-- down the next, dull strings that ring a little, wandering across the stereo
d6 $ note (arp "<up updown>" "<d5'min9'8 g5'dom9'8 d5'min9'8 bf4'maj9'8>") # s "sdgpluck" # legato 1
   # sdgdamp 0.5 # sdgdecay 0.8 # pan (slow 3 sine) # gain 0.8

-- d7, the strings: the chords held an octave below the piano, a slow attack,
-- filtered so they sit behind everything
d7 $ note "<d4'min9 g4'dom9 d4'min9 bf4'maj7>" # s "sdgstrings" # legato 1 # sdgatk 0.8 # sdgrel 1
   # sdgcut 2500 # sdgchorus 0.7 # gain 0.65

-- d8, percussion: the 808 rim and its claves in a part of twelve steps that
-- drifts against the bar, and the short cowbell (:1) on the "and" of three
d8 $ stack [
     s "{~ ~ sdgrim ~ ~ ~ sdgrim:1 ~ ~ sdgrim ~ ~}%16" # gain 0.85 # pan 0.3,
     s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ sdgcowbell:1 ~ ~ ~ ~ ~" # note "<0 0 0 -2>" # gain 0.8 # pan 0.7
   ]

-- d9, the ride on the eighths, quiet, short; the last one of the bar is struck
-- on its bell (sdgcolor toward 1)
d9 $ s "sdgcymbal:0*8" # sdgdecay 0.4 # gain "0.7 0.6 0.7 0.6 0.7 0.6 0.7 0.75"
   # sdgcolor "0.4 0.4 0.4 0.4 0.4 0.4 0.4 0.85"

-- variations, over the top of all of it

-- the chords echoed in dotted eighths, and the arpeggio turned round every
-- fourth bar
do
  d4 $ struct "~ t ~ ~ t ~ ~ ~ ~ t ~ ~ ~ ~ t ~" $ note "<d5'min9 g5'dom9 d5'min9 bf4'maj9>" # s "sdgfm"
     # sdgratio 1 # sdgindex 1.2 # sdgdecay 0.6 # legato 6 # gain 0.8 # pan 0.45
     # sdgspace 0.35 # sdgtime 0.369
  d6 $ every 4 rev $ note (arp "<up updown>" "<d5'min9'8 g5'dom9'8 d5'min9'8 bf4'maj9'8>") # s "sdgpluck"
     # legato 1 # sdgdamp 0.5 # sdgdecay 0.8 # pan (slow 3 sine) # gain 0.8

-- the kick gone for the last two bars of sixteen, the way a DJ pulls it: the
-- bass and the chords carry on alone
d1 $ whenmod 16 14 (const silence) $ s "sdgkick*4" # sdgdecay 0.45 # sdgclick 0.1 # sdgtone 0.2

-- the piano brighter and the strings opening, over 32 bars, by themselves
do
  d4 $ struct "~ t ~ ~ t ~ ~ ~ ~ t ~ ~ ~ ~ t ~" $ note "<d5'min9 g5'dom9 d5'min9 bf4'maj9>" # s "sdgfm"
     # sdgratio 1 # sdgindex (range 0.8 2.5 $ slow 32 sine) # sdgdecay 0.6 # legato 6 # gain 0.8 # pan 0.45
  d7 $ note "<d4'min9 g4'dom9 d4'min9 bf4'maj7>" # s "sdgstrings" # legato 1 # sdgatk 0.8 # sdgrel 1
     # sdgcut (range 1200 6000 $ slow 32 sine) # sdgchorus 0.7 # gain 0.65

-- the bass an octave up on its last note, every bar, and the hats straight
do
  d5 $ note "<[d2 ~ ~ d2 ~ ~ d2 d3] [g2 ~ ~ g2 ~ ~ g2 g3] [d2 ~ ~ d2 ~ ~ d2 d3] [bf2 ~ ~ bf2 ~ ~ f2 f3]>"
     # s "sdgsub" # legato 0.7 # sdgpunch 5 # gain 0.95
  d2 $ s "sdghat*8" # n "0 <0 2> 0 0 0 <2 0> 0 1" # cut 1 # gain "0.85 0.95"

hush
