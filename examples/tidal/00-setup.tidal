-- SuperDirtGUI from Tidal - 0: before you start
--
-- These files play what SuperDirtGUI adds to SuperDirt: a synth (sdgsine),
-- a per-event effect (sdgcomb), a sample player (sdgwarp) and a per-orbit
-- effect (sdgspace). They need SuperDirt running with SuperDirtGUI loaded
-- into it, in SuperCollider:
--
--   ~dirt.start(57120, 0 ! 12);
--   ~sdg = SuperDirtGUI(~dirt);
--   ~sdg.gui;
--
-- (examples/superdirt-gui-demo.scd does it a block at a time.) Evaluate
-- the blocks here one at a time, top to bottom.
--
--   0-setup        the words, and a first sound
--   1-synth        sdgsine: notes, length, bends, shape
--   2-module       sdgcomb: an effect on each event that asks for it
--   3-players      which player reads a sample, and how to choose
--   4-warp         the warp player: time and pitch apart
--   5-global       sdgspace: an echo that lives in the orbit
--   6-your-own     the copies you make with new... in the window
--   7-together     all of it at once

-- Every word SuperDirtGUI adds is a Tidal parameter. You can always write
-- it out - pF "sdgcomb" 0.4 - or evaluate this block once and write
-- sdgcomb 0.4. Paste it into your BootTidal.hs to have it every time.
let sdgshape = pF "sdgshape"
    sdgcomb = pF "sdgcomb"
    sdgres = pF "sdgres"
    sdgwarp = pF "sdgwarp"
    sdgpitch = pF "sdgpitch"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"
    player = pS "player"
    semi p = fmap (\x -> 2 ** (x / 12)) p

-- d1 to d12 play on orbit 0 to 11: d1 is the strip called orbit 0 in the
-- window, d2 is orbit 1, and so on. If you hear this, it is all there.
d1
$ superimpose ((hurry "4").(rev))
$ superimpose ((hurry "2").(rev))
$ s "sdgsine*4" # n "0 7 12 7"

d2 $ s "bd*4" # sdgcomb 0.3

hush

-- In SuperCollider, ~sdg.synthNames, ~sdg.moduleNames,
-- ~sdg.samplePlayerNames and ~sdg.globalEffectNames list everything you
-- can call - your own copies too.
