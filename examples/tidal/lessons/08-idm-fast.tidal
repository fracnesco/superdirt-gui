
setcps (165/60/4)

let sdgshape = pF "sdgshape"
    sdgcomb = pF "sdgcomb"
    sdgres = pF "sdgres"
    sdgwarp = pF "sdgwarp"
    sdgpitch = pF "sdgpitch"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"
    sdgcut = pF "sdgcut"
    sdgq = pF "sdgq"
    sdgenv = pF "sdgenv"
    sdgdecay = pF "sdgdecay"

-- orbit 0: the tune. Two sines a tenth of a semitone apart beat against each
-- other, and the echo is the only room it gets



d1
$ stutWith 6 (1/"<6 12>") ((|+note 12).(|* gain 0.8))
$ slow 4 $ jux (|+ note 0.1) $ note "e5 ~ g5 b5 ~ a5 g5 ~ e5 ~ d5 e5 ~ ~ b4 ~" -- |- note 12
   # s "sdgsine" # sdgshape 0.05 # legato 3 # gain 0.75
   # sdgspace 0.35 # sdgtime 0.27

-- orbit 1: chords, a saw with its filter nearly shut and no envelope
d2 $ slow 2 $ note "<e'min9 c'maj7 a'min9 b'min7>"
   # s "sdgacid" # legato 1.1 # sdgcut (range 350 900 $ slow 16 sine)
   # sdgq 0.15 # sdgenv 0.05 # gain 0.65 # pan (slow 3 sine)


-- now the drill: the same slices, with bursts inside them
d3 $ whenmod 8 6 (ply "<2 4>") $ someCyclesBy 0.2 (within (0.5, 1) (ply "2 4 3 6"))
   $ timeLoop 4 $ s "amencutup*16" # n (irand 32) # speed (range 0.98 1.04 perlin) # gain 1 # legato 0.6

-- orbit 3: kick and a snare that rolls and climbs at the end of the bar
d4 $ stack [
     s "808bd:3 ~ ~ 808bd:3 ~ ~ 808bd:3 ~" # shape 0.3,
     within (0.75, 1) (ply "<6 1 4 2>" . (# speed (range 1 2.4 saw)).(|* gain 0.9)) $ s "~ sn:3 ~ sn:3" # gain 0.9
   ]

-- orbit 4: a sub that barely moves, and acid that bites only now and then
d5 $ note "<e3 e3 c3 [a2 b2]>" # s "sdgacid" # legato 1 # sdgcut 140
   # sdgq 0.1 # sdgenv 0.2 # sdgdecay 0.2 # gain 0.85

-- ticks and bleeps high up, at an angle to everything
d6 $ rarely (ply 3) $ s "click*12" # n (irand 4) # pan rand # gain (range 0.5 0.8 rand) # hpf 3000



-- breakdown: the tune alone, then everything back at once
mapM_ (\f -> f silence) [d2, d3, d4, d5, d6, d7]

hush
