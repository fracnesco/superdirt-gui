-- SuperDirtGUI from Tidal - 21: samples picked by their tags
--
-- Every sample in the library is analysed once the window is open: how long
-- it sounds, how it starts, its bpm if it has one, its key or its note if it
-- has a pitch. From those it gets tags - short, medium, long, oneshot, loop,
-- percussive, sustained, melodic, noisy, kick, snare, hat, bass, bright,
-- dark - and bpm-unsure or key-unsure when the analysis is not sure. The
-- explorer's tag buttons show which ones your library has. Tags you add in
-- the explorer (t) or the editor work here the same way.
--
-- Tidal sends nothing without an s, so the pattern says sdgany: the whole
-- library. A bank's name instead picks inside that bank. Tags go in one word,
-- joined with a dot. Without an n, every event picks at random; with one, it
-- is the n-th match, wrapping round.

let sdgtag = pS "sdgtag"
    sdgnot = pS "sdgnot"
    sdgbpm = pF "sdgbpm"
    sdgkey = pS "sdgkey"

-- a different short drum on every step, never one with a pitch
d1 $ s "sdgany*8" # sdgtag "percussive.short" # sdgnot "melodic" # legato 1

-- the same, but held: n chooses, so the pattern repeats
d1 $ s "sdgany*8" # sdgtag "percussive.short" # sdgnot "melodic"
   # n "0 3 1 [5 2] 0 7 1 4"

-- kicks and hats, wherever they are in the library
d1 $ stack [
    s "sdgany(3,8)" # sdgtag "kick" # n 0,
    s "sdgany*8" # sdgtag "hat" # n (irand 4) # gain 0.8
  ]

-- a loop near 120 bpm - or 60, or 240: halves and doubles count - stretched
-- over a cycle at 120 bpm
setcps (120/60/4)

d2 $ s "sdgany" # sdgtag "loop" # sdgbpm 120 # n 0 # legato 1 # unit "c"

-- notes and chords in A minor (or one-shots on an A)
d3 $ s "sdgany(5,8)" # sdgtag "melodic" # sdgkey "am"
   # n (irand 8) # gain 0.9

-- the same keys in Tidal's spelling: s for sharp, f for flat
d3 $ s "sdgany*4" # sdgkey "<am fs bf e>"

-- inside one bank only: the long and dark ones of 808
d4 $ s "808*2" # sdgtag "long.dark"

-- whatever the analysis was sure of
d4 $ s "sdgany*4" # sdgtag "melodic" # sdgnot "key-unsure"

hush
