-- SuperDirtGUI from Tidal - 33: polyrhythms, a percussion piece
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. 108 bpm, and the bar counted two ways at once: in twelve (a 12/8
-- feel, four groups of three) by the kick, the congas, the bell and the tabla,
-- and in sixteen by the claves, so the two meet only on the downbeat. Eight
-- notes of a pluck against both, and five strikes of a bell in twelve. The
-- pitched parts are the marimba (sdgmodal:1), a kalimba-like pluck (sdgpluck)
-- and the cymbal's bell (sdgcymbal:4), all on the minor pentatonic above E.
-- The rest is the drum machine: sdgkick, sdgtom, sdgcowbell, sdgrim, sdgmodal
-- and sdghat as a shaker. sdgtime 0.417 is a dotted eighth here.
--
-- A polyrhythm is two pulses that agree once a bar. Listen for the downbeat:
-- everything lands on it, and nothing else lines up.

setcps (108/60/4)

let sdgdecay = pF "sdgdecay"
    sdgpunch = pF "sdgpunch"
    sdgclick = pF "sdgclick"
    sdgtone = pF "sdgtone"
    sdgmetal = pF "sdgmetal"
    sdgdamp = pF "sdgdamp"
    sdgbright = pF "sdgbright"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"



d1 => orbit 0
d2 => orbit 1
d3 => orbit 2
d4 => orbit 3
d5 => orbit 4
d6 => orbit 5
d7 => orbit 6
d8 => orbit 7
d9 => orbit 0
d10 => orbit 1
d11 => orbit 2


d2 $ trigger $ sound "bd(3,8)"


d1 $ fast 1$ s "bd(3,11)" # orbit 0

d9 $ s "bd*8" # orbit 2

d2 $ qtrigger $ sound "bd hh hh hh"


d1 $ s "hh*8"


d1 $ s "s"

  d2 $ s "sdgslam(7,13)" # n (irand 10) # legato 0.2

  d2 $ s "sdgkick(3,13,<0 3 2>)"

  d3 $ ply 2$ degradeBy 0.2 $ s "sdghat(11,13)" # n (irand 9) # legato (range 0.1 0.2 $ slow 32 perlin)

-- d1, the floor: the 808 kick on the first and seventh of twelve - the two
-- dotted quarters of the bar - soft, no beater
d1 $ s "sdgkick ~ ~ ~ ~ ~ sdgkick ~ ~ ~ ~ ~" # sdgdecay 0.5 # sdgpunch 6 # sdgclick 0 # gain 0.95

-- d2, congas and bongos: the conga (:3) and the bongo (:4) in a twelve-step
-- line, the bongo on the right, the conga up a tone every third bar
d2 $ s "~ sdgtom:3 sdgtom:3 ~ sdgtom:4 ~ sdgtom:3 ~ sdgtom:4 sdgtom:4 ~ sdgtom:3" # note "<0 0 2>"
   # gain "0.9 0.75 0.8" # pan "0.35 0.65"

-- d3, the bell: the agogo (:2) in the twelve-step bell pattern that West
-- African and Cuban music share, its two pitches a fourth apart
d3 $ s "sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2 sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2"
   # note "0 ~ 5 ~ 5 0 ~ 5 ~ 0 ~ 5" # sdgdecay 0.25 # gain 0.85 # pan 0.6

-- d4, the claves: the son clave in sixteen, against the twelve of everything
-- else; the two agree once a bar
d4 $ s "sdgrim:1 ~ ~ sdgrim:1 ~ ~ sdgrim:1 ~ ~ ~ sdgrim:1 ~ sdgrim:1 ~ ~ ~" # gain 0.7 # pan 0.3

-- d5, the tabla: a seven-step line played twelve steps to the bar, so it
-- starts somewhere else every bar and comes round after seven; its pitch
-- changes with the bar
d5 $ s "{sdgmodal:4 ~ sdgmodal:4 sdgmodal:4 ~ sdgmodal:0 ~}%12" # note "<0 7 -5>" # sdgdecay 0.5 # gain 0.85 # pan 0.6

-- d6, the marimba: twelve notes a bar on the pentatonic, an ostinato that
-- turns around on the seventh degree; it wanders across the stereo
d6 $ note (scale "minPent" "0 2 4 2 0 4 7 4 0 2 4 2" + 4) # s "sdgmodal:1" # sdgdecay 1.2 # gain 0.75
   # pan (slow 4 sine)

-- d7, the kalimba: a pluck, bright and dull at once, running up eight notes
-- of the scale an octave above the marimba, four in ten left out; eight
-- against twelve against sixteen
d7 $ degradeBy 0.4 $ note (scale "minPent" "0 1 2 3 4 5 6 7" + 16) # s "sdgpluck" # legato 2 # sdgdamp 0.6
   # sdgdecay 1 # sdgbright 0.8 # gain 0.75 # pan 0.7

-- d8, the shaker: the hat with noise in place of its squares (sdgmetal 0),
-- very short, on the sixteenths with the first of each four louder
d8 $ s "sdghat*16" # sdgmetal 0 # sdgdecay "0.04 0.02 0.03 0.02" # sdgtone 0.5 # gain "0.8 0.6 0.7 0.6" # pan 0.45

-- variations, over the top of all of it

-- the kick joins the claves: a sixteen-step kick on the clave's accents, so
-- the floor is in four while the rest is in three
d1 $ s "sdgkick ~ ~ sdgkick ~ ~ sdgkick ~ ~ ~ sdgkick ~ sdgkick ~ ~ ~" # sdgdecay 0.45 # sdgpunch 6 # sdgclick 0 # gain 0.95

-- the bell pattern rotated one step every third bar, and the tabla's line
-- reversed every fourth
do
  d3 $ every 3 (rot 1) $ s "sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2 sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2 ~ sdgcowbell:2"
     # note "0 ~ 5 ~ 5 0 ~ 5 ~ 0 ~ 5" # sdgdecay 0.25 # gain 0.85 # pan 0.6
  d5 $ every 4 rev $ s "{sdgmodal:4 ~ sdgmodal:4 sdgmodal:4 ~ sdgmodal:0 ~}%12" # note "<0 7 -5>" # sdgdecay 0.5 # gain 0.85 # pan 0.6

-- the pitched parts onto the major pentatonic: the same piece in the sun
do
  d6 $ note (scale "majPent" "0 2 4 2 0 4 7 4 0 2 4 2" + 4) # s "sdgmodal:1" # sdgdecay 1.2 # gain 0.75 # pan (slow 4 sine)
  d7 $ degradeBy 0.4 $ note (scale "majPent" "0 1 2 3 4 5 6 7" + 16) # s "sdgpluck" # legato 2 # sdgdamp 0.6
     # sdgdecay 1 # sdgbright 0.8 # gain 0.75 # pan 0.7
  d9 $ s "sdgcymbal:4(5,12,<0 3>)" # note "<0 7 4 0>" # sdgdecay 1.5 # gain 0.7 # sdgspace 0.3 # sdgtime 0.417

-- the marimba thinned to every other note, the shaker gone: room to hear the
-- three against four
do
  d6 $ degradeBy 0.5 $ note (scale "minPent" "0 2 4 2 0 4 7 4 0 2 4 2" + 4) # s "sdgmodal:1" # sdgdecay 1.2 # gain 0.75 # pan (slow 4 sine)
  d8 silence

hush
