-- SuperDirtGUI from Tidal - 32: hyperpop
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. C major, 150 bpm, and everything too bright and too clean, in
-- the manner of the PC Music records. The drums are the hyper-real pair of
-- file 18 (sdgslam, sdgplastic): a slam for the kick, latex snaps for the
-- snare, bubbles for the hats. A supersaw chord pumps as if a sidechain had
-- it (sdgsupersaw), a lead slides into every note like a pitched voice
-- (sdglead), sync zaps answer it (sdgsync), a choir sings the chord
-- (sdgchoir), a sub with a punch is the bass (sdgsub), and a crash and a
-- squeak are the effects. sdgtime 0.3 is a dotted eighth at this tempo.
--
-- The habit to copy is the contrast: huge and tiny, nothing in between, and
-- silence where a real band would play.

setcps (150/60/4)

let sdgmetal = pF "sdgmetal"
    sdgcolor = pF "sdgcolor"
    sdgbend = pF "sdgbend"
    sdgdecay = pF "sdgdecay"
    sdgwobble = pF "sdgwobble"
    sdgrise = pF "sdgrise"
    sdgdetune = pF "sdgdetune"
    sdgwidth = pF "sdgwidth"
    sdgcut = pF "sdgcut"
    sdgenv = pF "sdgenv"
    sdgatk = pF "sdgatk"
    sdgrel = pF "sdgrel"
    sdgsquare = pF "sdgsquare"
    sdgvib = pF "sdgvib"
    sdgvibdelay = pF "sdgvibdelay"
    sdgslide = pF "sdgslide"
    sdgglide = pF "sdgglide"
    sdgsweep = pF "sdgsweep"
    sdgvowel = pF "sdgvowel"
    sdgbreath = pF "sdgbreath"
    sdgpunch = pF "sdgpunch"
    sdgdrive = pF "sdgdrive"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the kick: the slam on one and the "and" of two, and every fourth bar
-- the dive (:1) on the last beat, the clang a little brighter than stock
d1 $ s "sdgslam ~ ~ ~ ~ ~ sdgslam ~ ~ ~ ~ ~ <~ ~ ~ sdgslam:1> ~ ~ ~" # sdgmetal 0.5 # sdgcolor 0.7

-- d2, the snare: latex snaps on two and four, tuned a little every bar, with
-- a wobble in them
d2 $ s "~ sdgplastic:1 ~ sdgplastic:1" # note "<0 0 2 -3>" # sdgwobble 0.3 # gain 0.95

-- d3, the hats: bubbles on the sixteenths, half of them gone, every one at
-- its own pitch, rising further on alternate bars, all over the stereo
d3 $ degradeBy 0.5 $ s "sdgplastic:0*16" # note (irand 24) # sdgrise "<14 24>" # pan rand # gain 0.8

-- d4, the chord: the supersaw, wide, retriggered on every eighth with the
-- level dipping on the beats - the pump of a sidechain, written out
d4 $ struct "t*8" $ note "<c5'maj a4'min f4'maj g4'maj>" # s "sdgsupersaw" # legato 0.95 # sdgdetune 0.5
   # sdgwidth 1 # sdgcut 5000 # sdgatk 0.02 # sdgrel 0.1 # gain "0.6 0.8 0.6 0.8 0.6 0.8 0.6 0.8"

-- d5, the lead: a tune over two bars, every note starting a few semitones
-- away and sliding home (sdgslide), the vibrato on almost at once; nearly
-- a sine, so it reads as a voice
d5 $ note "<[e6 ~ g6 ~ a6 ~ g6 e6] [d6 ~ ~ c6 ~ ~ ~ ~]>" # s "sdglead"
   # sdgslide "<[-2 ~ 3 ~ -5 ~ 2 -3] [3 ~ ~ -2 ~ ~ ~ ~]>" # sdgglide 0.08 # sdgvib 0.3 # sdgvibdelay 0.15
   # sdgcut 3000 # sdgenv 0.3 # sdgdetune 0.1 # sdgsquare 0.1 # legato 0.9 # gain 0.85

-- d6, zaps: the sync voice with its sweep all the way up, one or two notes
-- in the last beat of the third and fourth bars, echoed
d6 $ note "<~ ~ [~ ~ ~ c7] [~ ~ g6 c7]>" # s "sdgsync" # sdgsweep 8 # sdgdecay 0.25 # legato 0.8 # gain 0.8
   # sdgspace 0.3 # sdgtime 0.3

-- d7, the choir on the chord, two bars each, a different vowel each time, a
-- little out of tune with itself (sdgdetune), a short swell
d7 $ slow 2 $ note "<c5'maj9 a4'min9>" # s "sdgchoir" # legato 0.9 # sdgvowel "<0 2 1 3>" # sdgbreath 0.1
   # sdgdetune 0.4 # sdgatk 0.3 # sdgrel 0.5 # gain 0.65

-- d8, the bass: the sub on the roots, in the kick's rhythm and between, with
-- a big punch at the front of every note
d8 $ struct "t ~ ~ t ~ ~ t ~" $ note "<c3 a2 f2 g2>" # s "sdgsub" # legato 0.9 # sdgpunch 12 # sdgdecay 0.05
   # sdgdrive 0.4 # gain 0.9

-- d9, effects: a crash on the first beat of every fourth bar, and a squeak
-- (sdgplastic:2) on the fifteenth sixteenth now and then, up a fifth every
-- other time, somewhere in the stereo
d9 $ stack [
     every' 4 0 (const $ s "sdgcymbal:1 ~ ~ ~" # sdgdecay 1.5 # gain 0.75) silence,
     s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ <~ ~ sdgplastic:2 ~> ~" # note "<0 7>" # gain 0.85 # pan rand
   ]

-- variations, over the top of all of it

-- the kick as dives timed to the bar: at 150 a beat is 0.4 s, so a bend of
-- 0.8 s falls for two beats and lands on the next hit
d1 $ s "sdgslam:1 ~ sdgslam:1 ~" # sdgbend 0.8 # sdgdecay 1 # sdgmetal 0.3

-- the drop: the chord and the bass in a four-bar pattern with the last bar
-- empty, and the lead doubled an octave up, quieter
do
  d4 $ struct "<t*8 t*8 t*8 ~>" $ note "<c5'maj a4'min f4'maj g4'maj>" # s "sdgsupersaw" # legato 0.95
     # sdgdetune 0.5 # sdgwidth 1 # sdgcut 5000 # sdgatk 0.02 # sdgrel 0.1 # gain "0.6 0.8 0.6 0.8 0.6 0.8 0.6 0.8"
  d8 $ struct "<[t ~ ~ t ~ ~ t ~] [t ~ ~ t ~ ~ t ~] [t ~ ~ t ~ ~ t ~] ~>" $ note "<c3 a2 f2 g2>" # s "sdgsub"
     # legato 0.9 # sdgpunch 12 # sdgdecay 0.05 # sdgdrive 0.4 # gain 0.9
  d5 $ superimpose ((|+ note 12) . (|* gain 0.7)) $ note "<[e6 ~ g6 ~ a6 ~ g6 e6] [d6 ~ ~ c6 ~ ~ ~ ~]>" # s "sdglead"
     # sdgslide "<[-2 ~ 3 ~ -5 ~ 2 -3] [3 ~ ~ -2 ~ ~ ~ ~]>" # sdgglide 0.08 # sdgvib 0.3 # sdgvibdelay 0.15
     # sdgcut 3000 # sdgenv 0.3 # sdgdetune 0.1 # sdgsquare 0.1 # legato 0.9 # gain 0.85

-- the bubbles all in, twice as fast, and the snaps rubbery: the busiest it gets
do
  d3 $ s "sdgplastic:0*32" # note (irand 24) # sdgrise 24 # pan rand # gain 0.75
  d2 $ s "~ sdgplastic:1 ~ [sdgplastic:1 sdgplastic:1]" # note "<0 0 2 -3>" # sdgwobble 0.8 # gain 0.95

hush
