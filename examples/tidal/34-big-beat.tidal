-- SuperDirtGUI from Tidal - 34: big beat
--
-- Nine parts meant to play at once: evaluate d1 to d9 in order, then the
-- variations. E minor, 128 bpm. A break from Dirt-Samples cut up and re-cut
-- (breaks125, chop and bite), a Dirt-Samples kick with a synthesized 808
-- under it through the sdglayer player, a fat snare and a big clap (sdgsnare,
-- sdgclap), an acid bass with accents and slides (sdgacid), supersaw stabs
-- (sdgsupersaw), strings, a scratch on a spoken word (sdgscratch on numbers),
-- a crash and a roll every eight bars (sdgcymbal, sdgratchet) and an FM hook.
-- sdgtime 0.352 is a dotted eighth at this tempo.
--
-- Big beat is a break that is too loud, with a rock drummer's kick and snare
-- hitting on top of it, and one bass line that everybody can sing.

setcps (128/60/4)

let sdglayer = pF "sdglayer"
    sdgfreq = pF "sdgfreq"
    sdgpunch = pF "sdgpunch"
    sdgdecay = pF "sdgdecay"
    sdgnoise = pF "sdgnoise"
    sdgtail = pF "sdgtail"
    sdgcut = pF "sdgcut"
    sdgq = pF "sdgq"
    sdgenv = pF "sdgenv"
    sdgaccent = pF "sdgaccent"
    sdgslide = pF "sdgslide"
    sdgwave = pF "sdgwave"
    sdgdetune = pF "sdgdetune"
    sdgrel = pF "sdgrel"
    sdgatk = pF "sdgatk"
    sdgscratch = pF "sdgscratch"
    sdgdepth = pF "sdgdepth"
    sdgcount = pF "sdgcount"
    sdglen = pF "sdglen"
    sdgwalk = pF "sdgwalk"
    sdgratio = pF "sdgratio"
    sdgindex = pF "sdgindex"
    sdgspace = pF "sdgspace"
    sdgtime = pF "sdgtime"

-- d1, the break: breaks125 stretched over the bar (loopAt 1) and cut into
-- sixteen; every fourth bar its eighths come in another order, the last one
-- stuttered
d1 $ every 4 (bite 8 "0 1 2 3 0 1 6 [7 7]") $ loopAt 1 $ chop 16 $ s "breaks125:1" # gain 0.9

-- d2, the kick: a Dirt-Samples kick on one, the "and" of two and three, with
-- a synthesized 808 under it (sdglayer): a sine dropping onto 50 Hz, as loud
-- as the sample's own peak at 0.7
d2 $ s "bd:3 ~ ~ ~ ~ ~ bd:3 ~ ~ ~ bd:3 ~ ~ ~ ~ ~" # sdglayer 0.7 # sdgfreq 50 # sdgpunch 16 # sdgdecay 0.4 # gain 0.95

-- d3, the snare on two and four, the fat one (:4) with more noise, and the
-- big room clap (:3) with it on four only
d3 $ stack [
     s "~ sdgsnare:4 ~ sdgsnare:4" # sdgnoise 0.3 # gain 0.95,
     s "~ ~ ~ sdgclap:3" # sdgtail 0.7 # gain 0.85
   ]

-- d4, the bass: the acid voice on a riff in E, an accent on the third and
-- sixth notes, a slide up a fourth into the seventh; the filter breathes
-- over eight bars
d4 $ note "e3 e3 [e3 e4] e3 g3 e3 [b3 e3] d3" # s "sdgacid" # sdgcut (range 300 1800 $ slow 8 sine) # sdgq 0.75
   # sdgenv 0.6 # sdgdecay 0.18 # sdgaccent "0 0 1 0 0 1 0 0" # sdgslide "0 0 0 0 0 0 -5 0" # sdgwave 0
   # legato 0.7 # gain 0.9

-- d5, the stabs: a supersaw chord on the third, eleventh and fifteenth
-- sixteenths, a chord a bar, the filter shut and opened by each note
d5 $ struct "~ ~ t ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~ t ~" $ note "<e5'min7 g5'maj7 e5'min7 d5'maj7>" # s "sdgsupersaw"
   # legato 1.5 # sdgdetune 0.4 # sdgcut 1200 # sdgenv 0.6 # sdgdecay 0.15 # sdgrel 0.1 # gain 0.8

-- d6, the strings: two chords, two bars each, behind it all
d6 $ slow 2 $ note "<e4'min9 d4'maj9>" # s "sdgstrings" # legato 1 # sdgatk 0.5 # sdgcut 3000 # gain 0.55

-- d7, the scratch: two spoken numbers on the last quarter of the bar, the
-- read pointer wobbling four or nine times a second
d7 $ s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ numbers:7 ~ <numbers:2 ~> ~" # sdgscratch "<4 9>" # sdgdepth 0.03 # gain 0.85 # pan 0.3

-- d8, the crash on the first beat of every eighth bar, and in the bar before
-- it a bouncing roll (sdgratchet:0) on the last beat, climbing an octave
d8 $ stack [
     every' 8 0 (const $ s "sdgcymbal:1 ~ ~ ~" # sdgdecay 2.5 # gain 0.8) silence,
     whenmod 8 7 (const $ s "~ ~ ~ sdgratchet:0" # sdgcount 12 # sdglen 0.4 # sdgwalk 12 # gain 0.85) silence
   ]

-- d9, the hook: an FM line in E minor, every other bar, bright and short,
-- echoed in dotted eighths
d9 $ every 2 (const silence) $ note "e6 ~ g6 ~ b6 a6 ~ g6 ~ e6 ~ ~ d6 ~ ~ ~" # s "sdgfm" # sdgratio 2 # sdgindex 2.5
   # sdgdecay 0.3 # legato 1.5 # gain 0.75 # sdgspace 0.3 # sdgtime 0.352

-- variations, over the top of all of it

-- the break at double speed, an octave up, on the last bar of four, and the
-- bass line twice as fast on the same bar
do
  d1 $ every 4 (hurry 2) $ loopAt 1 $ chop 16 $ s "breaks125:1" # gain 0.9
  d4 $ every 4 (fast 2) $ note "e3 e3 [e3 e4] e3 g3 e3 [b3 e3] d3" # s "sdgacid" # sdgcut 1200 # sdgq 0.75
     # sdgenv 0.6 # sdgdecay 0.18 # sdgaccent "0 0 1 0 0 1 0 0" # sdgslide "0 0 0 0 0 0 -5 0" # sdgwave 0
     # legato 0.7 # gain 0.9

-- the breakdown: only the break and the strings for the last four bars of
-- sixteen, the kick and the bass gone
do
  d2 $ whenmod 16 12 (const silence) $ s "bd:3 ~ ~ ~ ~ ~ bd:3 ~ ~ ~ bd:3 ~ ~ ~ ~ ~" # sdglayer 0.7 # sdgfreq 50 # sdgpunch 16 # sdgdecay 0.4 # gain 0.95
  d4 $ whenmod 16 12 (const silence) $ note "e3 e3 [e3 e4] e3 g3 e3 [b3 e3] d3" # s "sdgacid" # sdgcut (range 300 1800 $ slow 8 sine) # sdgq 0.75 # sdgenv 0.6 # sdgdecay 0.18 # sdgaccent "0 0 1 0 0 1 0 0" # sdgslide "0 0 0 0 0 0 -5 0" # sdgwave 0 # legato 0.7 # gain 0.9
  d5 $ whenmod 16 12 (const silence) $ struct "~ ~ t ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~ t ~" $ note "<e5'min7 g5'maj7 e5'min7 d5'maj7>" # s "sdgsupersaw" # legato 1.5 # sdgdetune 0.4 # sdgcut 1200 # sdgenv 0.6 # sdgdecay 0.15 # sdgrel 0.1 # gain 0.8

-- the acid squelching: resonance up, the envelope wide, a square wave
d4 $ note "e3 e3 [e3 e4] e3 g3 e3 [b3 e3] d3" # s "sdgacid" # sdgcut (range 200 900 $ slow 4 sine) # sdgq 0.92
   # sdgenv 0.85 # sdgdecay 0.25 # sdgaccent "0 0 1 0 0 1 0 0" # sdgslide "0 0 0 0 0 0 -5 0" # sdgwave 1
   # legato 0.7 # gain 0.85

hush
